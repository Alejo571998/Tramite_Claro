# Clave de Gemini — SOLO del lado servidor (api/traducir.ts y el middleware de `vite dev`).
# No lleva prefijo VITE_ a propósito: así Vite nunca la mete en el bundle del cliente.
# Conseguí tu key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Chat de Taku: por defecto usa el chat real (api/taku.ts). "local" = sin red,
# responde solo con los datos del trámite abierto.
# VITE_TAKU_CHAT_MODE=local
# VITE_TAKU_CHAT_ENDPOINT=/api/taku

# Límite de uso global (opcional). Sin esto, el límite es por instancia en memoria.
# Se crean solos al agregar "Upstash for Redis" desde el Marketplace de Vercel.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cuentas en la nube con Supabase (opcional). Sin esto, las cuentas son locales.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_GOOGLE=1   # muestra "Continuar con Google" (configurar el proveedor en Supabase)
